# متغيرات جامع المنتجات — انسخ الملف ده باسم .env واملا القيم
# رابط مشروع Supabase (من Project Settings > API)
SUPABASE_URL=https://XXXXXXXX.supabase.co
# المفتاح العام anon/publishable (من Project Settings > API)
SUPABASE_KEY=ضع_المفتاح_العام_هنا
# نفس الكلمة اللي حطيتها في ingest_token جوه database/settings.sql
INGEST_TOKEN=نفس_مفتاح_الجامع_السري

# 0 = جامع أمازون الأساسي واقف (أوفر). خليه 1 وقت اللانش
AMAZON_MAIN=0
# عدد الكتابات في نفس الوقت على قاعدة البيانات (1 مناسب للخطة المجانية)
DB_CONCURRENCY=1
SWEEP_WORKERS=2
# كود أفلييت أمازون
AMAZON_TAG=3rodmattfwt4-21
